# HTTP / WebSocket port exposed to the frontend
PORT=3001

# UDP port the backend binds to receive firmware telemetry
FW_LISTEN_PORT=5001

# UDP host:port the backend sends telecommands to (firmware listener)
FW_TC_HOST=127.0.0.1
FW_TC_PORT=5002

# Pre-shared key for HMAC-SHA-256 telecommand authentication.
# Must match APOGEE_PSK_HEX in apps/firmware/src/auth.h.
# 32 random bytes hex-encoded (64 hex chars).
APOGEE_HMAC_KEY=8f4a2d6e9c1b73f50a82d7e3b9c64f1a5d3b8e7c029f4a16d8b2c5e7f9a14380
